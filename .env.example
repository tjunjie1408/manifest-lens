# Drizzle / PostgreSQL
# Local dev points at the Docker Compose database (`docker compose up -d db`).
# Production uses a managed PostgreSQL connection string (never a bundled DB).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/averis

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# AI service seam (optional) — only needed once you implement src/lib/server/services/ai.ts
AI_API_KEY=""

# Local shipping review uses the worker virtual environment by default.
# Set an absolute Python executable path when that environment is elsewhere.
SHIPPING_PYTHON=""
